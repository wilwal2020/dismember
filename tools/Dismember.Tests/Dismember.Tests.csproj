<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline test harness: runs the slicing core against real NPC data read from your BONELAB install. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Dismember\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Dismember\Assets\BundleMeshReader.cs" Link="Assets\BundleMeshReader.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="AssetsTools.NET"><HintPath>$(BonelabPath)\MelonLoader\net6\AssetsTools.NET.dll</HintPath></Reference>
  </ItemGroup>
</Project>
